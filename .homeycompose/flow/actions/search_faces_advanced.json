  "titleFormatted": {
    "en": "Search faces in [[droptoken]] from [[origin]]",
    "nl": "Zoek gezichten in [[droptoken]] van [[origin]]",
    "de": "Gesichter in [[droptoken]] suchen von [[origin]]",
    "fr": "Rechercher des visages dans [[droptoken]] depuis [[origin]]",
    "es": "Buscar caras en [[droptoken]] desde [[origin]]",
    "it": "Cerca volti in [[droptoken]] da [[origin]]",
    "da": "Søg ansigter i [[droptoken]] fra [[origin]]",
    "sv": "Sök ansikten i [[droptoken]] från [[origin]]",
    "no": "Søk ansikter i [[droptoken]] fra [[origin]]",
    "pl": "Szukaj twarzy w [[droptoken]] z [[origin]]",
    "ru": "Поиск лиц на [[droptoken]] с [[origin]]",
    "ar": "البحث عن الوجوه في [[droptoken]] من [[origin]]",
